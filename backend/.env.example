# Copy this file to backend/.env and fill in your own Supabase project values.
# Find them in the Supabase dashboard under Project Settings > API.
# Never commit the real .env file.

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# API key for the project (anon/publishable key for local development)
SUPABASE_KEY=your-supabase-anon-key
